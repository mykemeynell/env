{
    "name": "mykemeynell/env",
    "description": "Load and retrieve dotenv and YAML environment configuration.",
    "type": "library",
    "keywords": [
        "configuration",
        "dotenv",
        "env",
        "environment",
        "php",
        "yaml"
    ],
    "homepage": "https://github.com/mykemeynell/dotenv",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "symfony/yaml": "^7.4.12 || ^8.0.12",
        "vlucas/phpdotenv": "^5.7"
    },
    "autoload": {
        "psr-4": {
            "mykemeynell\\Env\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "laravel/pint": "^1.26",
        "pestphp/pest": "^4.7",
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "analyze": "phpstan analyse --memory-limit=1G",
        "lint": "pint",
        "lint:check": "pint --test",
        "test": "pest",
        "test:coverage": "pest --coverage --min=100"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    }
}
